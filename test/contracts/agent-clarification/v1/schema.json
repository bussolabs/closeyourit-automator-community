{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closeyour.it/contracts/agent-clarification/v1/schema.json",
  "title": "CloseYourIt agent clarification state contract v1",
  "oneOf": [
    { "$ref": "#/$defs/clarification_state" }
  ],
  "$defs": {
    "clarification_round": {
      "type": "object",
      "required": ["cycle", "questions", "response", "answered_at", "created_at"],
      "properties": {
        "cycle": { "type": "integer", "minimum": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "response": { "type": ["string", "null"] },
        "answered_at": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "clarification_state": {
      "type": "object",
      "required": ["state", "cycles", "has_reply", "rounds"],
      "properties": {
        "state": { "enum": ["ready", "waiting", "escalated"] },
        "cycles": { "type": "integer", "minimum": 0 },
        "has_reply": { "type": "boolean" },
        "rounds": { "type": "array", "items": { "$ref": "#/$defs/clarification_round" } }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "waiting" } }, "required": ["state"] },
          "then": { "properties": { "rounds": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    }
  }
}
